extends CPUParticles2D

## Разовый "взрыв" частиц крови - создаётся в момент попадания урона и сам
## уничтожает себя, как только всё отыграет. Количество частиц и вообще всё
## остальное (разброс, скорость, цвет, гравитация) настраивается прямо на
## этом узле в редакторе - никакого отдельного кода под каждый параметр.
## Текстуры пока нет - без неё частицы рисуются просто цветными квадратиками
## (уже жёлтые), достаточно чтобы проверить, что всё работает. Как только
## нарисуешь свою частицу - просто перетащи PNG в поле Texture этого узла.
func burst(count: int) -> void:
	amount = count
	restart()
	emitting = true
	await get_tree().create_timer(lifetime + 0.2).timeout
	queue_free()
